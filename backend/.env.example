AGENTPRO_ENV=local
# 本地/桌面默认绑定回环地址；容器/服务器部署显式设为 0.0.0.0（Docker CMD 已带 --host 0.0.0.0）。
AGENTPRO_API_HOST=127.0.0.1
AGENTPRO_API_PORT=8000
AGENTPRO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,tauri://localhost
# 留空则按环境自动决定：local/test 开启 API 文档，其余环境关闭。可显式设为 true/false 覆盖。
# AGENTPRO_DOCS_ENABLED=

# Do not commit real secrets. Configure these only in local/server .env files.
AGENTPRO_DATABASE_URL=mysql+asyncmy://agentpro_user:CHANGE_ME@mysql-host:3306/agentpro
AGENTPRO_REDIS_URL=redis://redis:6379/0
# 生产环境必须为 ≥32 字符的随机串，否则服务拒绝启动：python -c "import secrets;print(secrets.token_urlsafe(48))"
AGENTPRO_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AGENTPRO_ACCESS_TOKEN_MINUTES=30
AGENTPRO_REFRESH_TOKEN_DAYS=30
AGENTPRO_EMAIL_CODE_EXPIRE_MINUTES=10
AGENTPRO_EMAIL_CODE_COOLDOWN_SECONDS=60
AGENTPRO_SMTP_HOST=smtp.qcloudmail.com
AGENTPRO_SMTP_PORT=465
AGENTPRO_SMTP_USER=CHANGE_ME
AGENTPRO_SMTP_PASSWORD=CHANGE_ME
AGENTPRO_SMTP_FROM=AgentPro <noreply@example.com>
